# Demo settings: a local MinIO filled with sample photos, no sign-in.
#
#   cp .env.demo .env
#   docker compose --profile demo up -d --build
#
# Then open http://localhost:3100. Everything here is local to your machine;
# none of these values is a secret. For your own photos, start from
# .env.template instead.

# Starts MinIO and the seeding job with every docker compose command
COMPOSE_PROFILES=demo

# Host ports: the gallery, and MinIO's S3 API (signed download links)
BLAZE_PORT=3100
MINIO_PORT=9100

# The bucket the demo fills. MinIO's root user is these same credentials.
BACKBLAZE_ENDPOINT=http://minio:9000
BACKBLAZE_PUBLIC_ENDPOINT=http://localhost:9100
BACKBLAZE_BUCKET=photos
BACKBLAZE_ACCESS_KEY=blaze-demo
BACKBLAZE_SECRET_KEY=blaze-demo-secret

# No sign-in: anyone who reaches port 3100 can browse, share and delete.
# Fine on your laptop; never expose this setup.
ALLOW_PUBLIC_ACCESS=true

# Lets the seeding job start the sync (Authorization: Bearer <API_KEY>)
API_KEY=blaze-demo-api-key

NEXT_PUBLIC_APP_URL=http://localhost:3100
